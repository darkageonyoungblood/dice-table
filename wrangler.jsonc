{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dice-table",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // Serves everything in ./public. The Worker handles /api/* and /ws,
  // and falls through to this binding for the client HTML.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "durable_objects": {
    "bindings": [
      { "name": "TABLE", "class_name": "Table" }
    ]
  },

  // Legacy migration syntax. Supported by every wrangler 4.x, which makes
  // it the safer choice for Cloudflare's build runner.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Table"] }
  ],

  "observability": { "enabled": true }
}
